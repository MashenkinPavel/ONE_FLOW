FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1;

// Вершины (vertices) прямоугольного параллелепипеда 2x1x1 м
//       7 ------- 6
//      /|        /|
//     / |       / |
//    4 ------- 5  |
//    |  |      |  |
//    |  3 - - -| - 2
//    | /       | /
//    |/        |/
//    0 ------- 1
vertices
(
    (0 0 0)     // 0
    (2 0 0)     // 1
    (2 1 0)     // 2
    (0 1 0)     // 3
    (0 0 1)     // 4
    (2 0 1)     // 5
    (2 1 1)     // 6
    (0 1 1)     // 7
);

// Блоки (blocks): один блок, разбиение 2 ячейки по X, 1 по Y, 1 по Z
blocks
(
    hex (0 1 2 3 4 5 6 7) (2 1 1) simpleGrading (1 1 1)
);

edges
(
);

// Граничные условия (boundary)
boundary
(
    // Левая грань (x = 0)
    left
    {
        type wall;
        faces
        (
            (0 3 7 4)
        );
    }
    // Правая грань (x = 2)
    right
    {
        type wall;
        faces
        (
            (1 2 6 5)
        );
    }
    // Нижняя грань (z = 0)
    bottom
    {
        type wall;
        faces
        (
            (0 1 2 3)
        );
    }
    // Верхняя грань (z = 1)
    top
    {
        type wall;
        faces
        (
            (4 5 6 7)
        );
    }
    // Передняя грань (y = 0)
    front
    {
        type wall;
        faces
        (
            (0 4 5 1)
        );
    }
    // Задняя грань (y = 1)
    back
    {
        type wall;
        faces
        (
            (3 2 6 7)
        );
    }
);

